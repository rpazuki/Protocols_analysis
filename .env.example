# Lab Protocols Analysis - environment configuration
#
# Copy to .env for local development. Never commit a real .env: it holds the
# database password, the session secret, and the SSO client secret.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
APP_NAME="Lab Protocols Analysis"
APP_URL=http://localhost:3000/protocols
APP_BASE_PATH=/protocols
NEXT_PUBLIC_BASE_PATH=/protocols
APP_VERSION=0.1.0

# Shown as a banner in every non-production environment. Leave empty in production.
ENVIRONMENT_LABEL=DEVELOPMENT

# Report dates are calendar dates in this timezone, so "today" matches the lab's day.
APP_TIMEZONE=Europe/London

# Signs the session cookie. Generate with: openssl rand -base64 48
# Required in production and must be at least 32 characters.
SESSION_SECRET=development-only-insecure-session-secret-change-me
SESSION_TTL_HOURS=12

# Extra origins allowed to post server actions, for a reverse-proxied deployment.
# ALLOWED_ORIGINS=https://rlalab-assist.dept.ic.ac.uk

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Migrations run as the owner. The app itself should connect as protocols_app,
# which has no schema rights and cannot rewrite audit history (db/migrations/0002).
DATABASE_URL=postgres://protocols:protocols@localhost:5432/protocols
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# mock | local | entra-oidc | shibboleth-saml
# The app refuses to start with mock when NODE_ENV=production.
AUTH_ADAPTER=mock
# Use AUTH_ADAPTER=local for real email/password accounts without SSO (also production).
# Provision accounts with: npm run local-users -- create person@ic.ac.uk
# APP_HOST_PORT is the production Compose loopback port; container port stays 3000.
APP_HOST_PORT=3200

# Optional tenancy guard: sign-in is refused for addresses outside these domains,
# even if the identity provider authenticated them successfully.
# ALLOWED_EMAIL_DOMAINS=ic.ac.uk,imperial.ac.uk

# Bootstrap admin allowlist. Required in production - without it nobody can
# administer the app. These entries are reinstated on every start, which is the
# documented break-glass recovery route.
ADMIN_BOOTSTRAP_EMAILS=mock.admin@ic.ac.uk

# Addresses refused after successful Imperial sign-in. There is deliberately no
# researcher allowlist: SSO is the membership check, and admins block named
# individuals here instead. Normally managed from /admin/access; this variable
# exists so an urgent block can be applied on the VM without an admin session.
#
# While an address is listed here it is pinned: re-applied on every start and
# not liftable from the admin page. Removing it from this list unpins it but
# does NOT restore access - the block stays in force and becomes an ordinary
# entry an admin can then lift, so tidying this file never silently gives
# someone their access back.
# ACCESS_DENYLIST_EMAILS=former.member@ic.ac.uk

# ---------------------------------------------------------------------------
# Authorization policy (plan open decisions 2 and 3)
# ---------------------------------------------------------------------------
# Researchers may restore their own recycled reports.
ALLOW_RESEARCHER_RESTORE=true
# Researchers may permanently delete their own recycled reports.
ALLOW_RESEARCHER_PERMANENT_DELETE=true
# Days a report must sit in the recycle bin before permanent delete is offered. 0 = no wait.
PERMANENT_DELETE_WAIT_DAYS=0

# ---------------------------------------------------------------------------
# Export
# ---------------------------------------------------------------------------
# Refuses exports larger than this, so one click cannot pull the whole lab record by accident.
EXPORT_MAX_ROWS=100000

# ---------------------------------------------------------------------------
# Microsoft Entra ID / OIDC (production-preferred; needs ICT app registration)
# ---------------------------------------------------------------------------
# ENTRA_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# ENTRA_REDIRECT_URI=https://rlalab-assist.dept.ic.ac.uk/protocols/auth/callback
# ENTRA_POST_LOGOUT_REDIRECT_URI=https://rlalab-assist.dept.ic.ac.uk/protocols
# ENTRA_SCOPES=openid,profile,email
# ENTRA_EMAIL_CLAIM=email

# ---------------------------------------------------------------------------
# Shibboleth / SAML (production alternative; SP terminates SAML in front of the app)
# ---------------------------------------------------------------------------
# Shared secret the service provider injects on every proxied request. Without
# it the app cannot distinguish a real SP request from forged attribute headers.
# SHIBBOLETH_PROXY_SECRET=
# SHIBBOLETH_PROXY_HEADER_NAME=x-sp-proxy-secret
# SHIBBOLETH_EMAIL_HEADER=mail
# SHIBBOLETH_SESSION_HEADER=shib-session-id
# SHIBBOLETH_DISPLAYNAME_HEADER=displayname
# SHIBBOLETH_SUBJECT_HEADER=persistent-id
# SHIBBOLETH_IDP_ENTITY_ID=https://shibboleth.imperial.ac.uk/shibboleth
# SHIBBOLETH_LOGIN_PATH=/Shibboleth.sso/Login
# SHIBBOLETH_LOGOUT_PATH=/Shibboleth.sso/Logout

# ---------------------------------------------------------------------------
# Mock API (development only)
# ---------------------------------------------------------------------------
MOCK_API_PORT=4000
